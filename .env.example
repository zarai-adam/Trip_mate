# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# API Base URL for the frontend. Sensibly defaults to empty (relative `/api`) for local development, or can be set to the deployed backend URL.
VITE_API_URL=

# Database (Neon Postgres / Relational SQL)
DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port (Railway will inject this automatically, defaults to 3000 locally)
PORT=3000

# CORS settings: URL of the hosted frontend (separate from the backend)
FRONTEND_URL="https://my-frontend.vercel.app,https://my-development-url.vercel.app"

# Auth
JWT_SECRET="super-secret-key-change-this"
JWT_REFRESH_SECRET="another-super-secret-key"

# Stripe (Optional for now)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
