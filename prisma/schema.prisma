generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EXPLORER
  GUIDE
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum GuideApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  DRAFT
  PUBLISHED
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

enum TripType {
  DESERT
  COAST
  MOUNTAIN
  CITY
  CULTURAL
  MIXED
  ADVENTURE
  RELAXATION
  NATURE
  HERITAGE
  ARCTIC
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReviewerType {
  EXPLORER_REVIEWING_GUIDE
  GUIDE_REVIEWING_EXPLORER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  passwordHash     String
  role             UserRole     @default(EXPLORER)
  firstName        String
  lastName         String
  avatarUrl        String?
  bio              String?      @db.Text
  phoneNumber      String?
  country          String?
  coverUrl         String?
  tagline          String?
  languages        String[]
  countriesVisited String[]
  specialties      String[]
  travelPhilosophy String?      @db.Text
  responseRate     Float?       @default(100)
  responseTime     String?      @default("within a few hours")
  status           UserStatus   @default(ACTIVE)
  emailVerified    Boolean      @default(false)
  verificationToken String?
  ratingAverage    Float        @default(0)
  totalReviews     Int          @default(0)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  guideApplications GuideApplication[]
  tripsLed          Trip[]             @relation("GuideTrips")
  bookings          Booking[]          @relation("ExplorerBookings")
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")
  notifications     Notification[]
  questions         TripQuestion[]
  reportsGiven      Report[]           @relation("ReportsGiven")
  actorLogs         ActivityLog[]      @relation("ActorLogs")
  reviewedApps      GuideApplication[] @relation("AdminReviewer")
  conversations     Conversation[]     @relation("ConversationParticipants")
  messagesSent      Message[]          @relation("MessagesSent")
  messagesRead      Message[]          @relation("MessageReadBy")

  @@index([email])
  @@index([role, status])
}

model Report {
  id          String   @id @default(uuid()) @db.Uuid
  reporterId  String   @db.Uuid
  reporter    User     @relation("ReportsGiven", fields: [reporterId], references: [id])
  targetType  String   // "TRIP", "USER"
  targetId    String   @db.Uuid
  reason      String   // Misleading info, Safety concern, etc.
  description String?  @db.Text
  status      ReportStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

model Conversation {
  id              String           @id @default(uuid()) @db.Uuid
  type            ConversationType @default(DIRECT)
  tripId          String?          @db.Uuid
  trip            Trip?            @relation(fields: [tripId], references: [id])
  participants    User[]           @relation("ConversationParticipants")
  messages        Message[]
  lastMessageAt   DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tripId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.Uuid
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id])
  body           String       @db.Text
  readBy         User[]       @relation("MessageReadBy")
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

enum ConversationType {
  DIRECT
  GROUP
}

model GuideApplication {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String                 @db.Uuid
  user              User                   @relation(fields: [userId], references: [id])
  travelExperience  String                 @db.Text
  countriesVisited  String[]
  languagesSpoken   String[]
  specialties       String[]
  whyBecomeGuide    String                 @db.Text
  certifications    String[]
  socialMediaLinks  String[]
  portfolioUrls     String[]
  status            GuideApplicationStatus @default(PENDING)
  reviewedById      String?                @db.Uuid
  reviewedBy        User?                  @relation("AdminReviewer", fields: [reviewedById], references: [id])
  reviewNotes       String?                @db.Text
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId, status])
}

model Trip {
  id                String     @id @default(uuid()) @db.Uuid
  guideId           String     @db.Uuid
  guide             User       @relation("GuideTrips", fields: [guideId], references: [id])
  title             String
  slug              String     @unique
  description       String     @db.Text
  destination       String
  startDate         DateTime
  endDate           DateTime
  durationDays      Int
  difficulty        Difficulty
  tripType          TripType
  pricePerPerson    Decimal    @default(0) @db.Decimal(10, 2)
  currency          String     @default("USD") @db.VarChar(3)
  groupSizeMin      Int
  groupSizeMax      Int
  currentParticipants Int      @default(0)
  status            TripStatus @default(DRAFT)
  itinerary         Json       // Array of day objects
  inclusions        String[]
  exclusions        String[]
  meetingPoint      String
  tripLanguage      String     @default("English")
  isSoloFriendly    Boolean    @default(true)
  coverImageUrl     String?
  galleryImageUrls  String[]
  tags              String[]
  latitude          Float?
  longitude         Float?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  bookings  Booking[]
  reviews   Review[]
  questions TripQuestion[]
  conversations Conversation[]

  @@index([destination])
  @@index([status])
  @@index([startDate, endDate])
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  tripId         String        @db.Uuid
  trip           Trip          @relation(fields: [tripId], references: [id])
  explorerId     String        @db.Uuid
  explorer       User          @relation("ExplorerBookings", fields: [explorerId], references: [id])
  status         BookingStatus @default(REQUESTED)
  introMessage   String?       @db.VarChar(500)
  guideResponse  String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reviews Review[]

  @@index([tripId])
  @@index([explorerId])
}

model Review {
  id             String       @id @default(uuid()) @db.Uuid
  tripId         String       @db.Uuid
  trip           Trip         @relation(fields: [tripId], references: [id])
  bookingId      String       @db.Uuid
  booking        Booking      @relation(fields: [bookingId], references: [id])
  reviewerId     String       @db.Uuid
  reviewer       User         @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId     String       @db.Uuid
  reviewee       User         @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewerType   ReviewerType
  rating         Int
  comment        String       @db.Text
  isVisible      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tripId])
  @@index([revieweeId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  actor       User     @relation("ActorLogs", fields: [actorId], references: [id])
  action      String   // e.g., "USER_SUSPENDED", "GUIDE_APPROVED", "TRIP_DELETED"
  targetType  String   // e.g., "User", "Trip", "Booking"
  targetId    String   @db.Uuid
  details     Json?    // Additional context
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model TripQuestion {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  question  String   @db.Text
  answer    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   // "TRIP_VIEW", "PROFILE_VIEW", etc.
  targetId  String   @db.Uuid // tripId or userId
  metadata  Json?    // For tracking things like country of the viewer (e.g. { country: "US" })
  createdAt DateTime @default(now())

  @@index([type, targetId, createdAt])
}
